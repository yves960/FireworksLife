{
  "name": "yufu-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"node scripts/mock-server.mjs\" \"astro dev\"",
    "dev:no-mock": "astro dev",
    "dev:mock": "concurrently \"node scripts/mock-server.mjs\" \"astro dev\"",
    "check:content": "node scripts/check-pubdate.mjs",
    "prebuild": "node scripts/check-pubdate.mjs",
    "build": "astro build",
    "build:no-check": "astro build",
    "mock": "node scripts/mock-server.mjs",
    "reset-mock": "node -e \"fetch('http://localhost:'+(process.env.MOCK_PORT||4322)+'/__reset',{method:'POST'}).then(r=>r.json()).then(d=>console.log('[mock] reset:',JSON.stringify(d))).catch(()=>{console.error('[mock] ERROR: mock server 未运行（先 npm run mock）');process.exit(1)})\"",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "^8.1.0",
    "astro": "^7.2.1",
    "motion": "^12.38.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
