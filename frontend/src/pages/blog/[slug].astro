---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = Math.max(1, Math.ceil((post.body?.split(/\s+/).length ?? 0) / 220));
const wordCount = post.body?.replace(/\s+/g, '').length ?? 0;
const postSlug = post.id;
const postTitle = post.data.title;
const sortedAll = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = sortedAll.findIndex((item) => item.id === post.id);
const newerPost = currentIndex > 0 ? sortedAll[currentIndex - 1] : null;
const olderPost =
  currentIndex >= 0 && currentIndex < sortedAll.length - 1 ? sortedAll[currentIndex + 1] : null;
---

<Base title={post.data.title} description={post.data.description} image={post.data.cover}>
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <article class="blog-post">
    <a href="/" class="back-link reveal" style="--reveal-delay: 0">返回首页</a>

    <header class="post-hero reveal" style="--reveal-delay: 1">
      <div class="hero-topline">
        <span>{post.data.category}</span>
        {post.data.subTag && <span>{post.data.subTag}</span>}
      </div>

      <div class="hero-layout">
        <div class="hero-copy">
          <h1>{post.data.title}</h1>
          <p class="post-summary">{post.data.description}</p>

          <div class="post-meta">
            <time>{new Date(post.data.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <div class="meta-tags">
              {(post.data.tags || []).map((tag) => <span>{tag}</span>)}
            </div>
          </div>

          <div class="engagement-bar" data-post-slug={postSlug} data-post-title={postTitle}>
            <button type="button" class="engage-button" id="likeButton" aria-pressed="false" aria-label="点赞">
              <span>点赞</span>
              <strong id="likeCount">—</strong>
            </button>
            <button type="button" class="engage-button" id="favoriteButton" aria-pressed="false" aria-label="收藏">
              <span>收藏</span>
              <strong id="favoriteState">未收藏</strong>
            </button>
          </div>
        </div>

        <aside class="meta-panel" data-spotlight>
          <p class="meta-panel-kicker">Reading Brief</p>
          <div class="meta-grid">
            <div>
              <span class="meta-label">阅读时长</span>
              <strong>{readingMinutes} min</strong>
            </div>
            <div>
              <span class="meta-label">字数</span>
              <strong>{wordCount.toLocaleString()}</strong>
            </div>
            <div>
              <span class="meta-label">栏目</span>
              <strong>{post.data.category}</strong>
            </div>
          </div>
          {headings.length > 0 && (
            <div class="toc-block">
              <p class="meta-label">章节导航</p>
              <ul>
                {headings.slice(0, 5).map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </header>

    <div class="content-shell reveal" style="--reveal-delay: 2">
      <div class="reading-rail" aria-hidden="true">
        <span></span>
      </div>
      <div class="content">
        <Content />
      </div>
      <aside class="quote-panel">
        <p class="quote-kicker">Margin Note</p>
        <blockquote>内容不只是被阅读，也应该被布置。页面的节奏，本身就是表达的一部分。</blockquote>
        <p class="quote-note">这里保留杂志边栏感，让长文阅读不至于只剩一条纯正文通道。</p>
      </aside>
    </div>

    <nav class="post-neighbors reveal" style="--reveal-delay: 3" aria-label="相邻文章">
      {olderPost && (
        <a class="neighbor-link" href={`/blog/${olderPost.id}/`}>
          <span>← 上一篇</span>
          <strong>{olderPost.data.title}</strong>
        </a>
      )}
      {newerPost && (
        <a class="neighbor-link neighbor-newer" href={`/blog/${newerPost.id}/`}>
          <span>下一篇 →</span>
          <strong>{newerPost.data.title}</strong>
        </a>
      )}
    </nav>

    <section class="comments-shell reveal" style="--reveal-delay: 3" data-post-slug={postSlug} data-post-title={postTitle}>
      <div class="comments-head">
        <div>
          <p class="quote-kicker">Comments</p>
          <h2>留言板</h2>
        </div>
        <p class="comments-note">评论、点赞和收藏会通过 Netlify Functions 存储，不再只是留在本地浏览器。</p>
      </div>

      <form class="comment-form" id="commentForm">
        <input id="commentAuthor" type="text" maxlength="24" placeholder="你的名字" />
        <textarea id="commentContent" rows="4" maxlength="300" placeholder="写点想法、反馈或者吐槽"></textarea>
        <input id="replyParentId" type="hidden" value="" />
        <input class="honeypot" id="commentWebsite" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="replying-banner" id="replyingBanner" style="display: none;">
          <span id="replyingText"></span>
          <button type="button" class="reply-cancel" id="replyCancel">取消回复</button>
        </div>
        <button type="submit" class="comment-submit">发布评论</button>
      </form>

      <p class="comment-status" id="commentStatus"></p>
      <div class="comment-list" id="commentList"></div>
      <p class="comment-empty" id="commentEmpty">还没有评论，来留下第一条。</p>
    </section>

    <div class="post-end reveal" style="--reveal-delay: 4">
      <a href="/" class="back-link">继续逛首页</a>
    </div>
  </article>
</Base>

<script>
  const engagementBar = document.querySelector('.engagement-bar') as HTMLElement | null;
  const commentsShell = document.querySelector('.comments-shell') as HTMLElement | null;
  const likeButton = document.getElementById('likeButton') as HTMLButtonElement | null;
  const favoriteButton = document.getElementById('favoriteButton') as HTMLButtonElement | null;
  const likeCount = document.getElementById('likeCount');
  const favoriteState = document.getElementById('favoriteState');
  const commentForm = document.getElementById('commentForm') as HTMLFormElement | null;
  const commentAuthor = document.getElementById('commentAuthor') as HTMLInputElement | null;
  const commentContent = document.getElementById('commentContent') as HTMLTextAreaElement | null;
  const commentList = document.getElementById('commentList');
  const commentEmpty = document.getElementById('commentEmpty');
  const commentStatus = document.getElementById('commentStatus');
  const commentSubmit = document.querySelector('.comment-submit') as HTMLButtonElement | null;
  const replyParentId = document.getElementById('replyParentId') as HTMLInputElement | null;
  const replyingBanner = document.getElementById('replyingBanner');
  const replyingText = document.getElementById('replyingText');
  const replyCancel = document.getElementById('replyCancel') as HTMLButtonElement | null;

  const postSlug = engagementBar?.dataset.postSlug || commentsShell?.dataset.postSlug || '';
  const postTitle = engagementBar?.dataset.postTitle || commentsShell?.dataset.postTitle || '';

  const authorKey = 'yufu:comment-author';

  // Restore saved author name
  if (commentAuthor) {
    const savedAuthor = localStorage.getItem(authorKey);
    if (savedAuthor) {
      commentAuthor.value = savedAuthor;
    }
  }

  const clientIdKey = 'yufu:client-id';
  const getClientId = () => {
    let current = localStorage.getItem(clientIdKey);
    if (!current) {
      current = crypto.randomUUID();
      localStorage.setItem(clientIdKey, current);
    }
    return current;
  };

  const setStatus = (message = '', isError = false) => {
    if (!commentStatus) return;
    commentStatus.textContent = message;
    commentStatus.classList.toggle('is-error', isError);
  };

  const applyEngagementState = (data: {
    liked?: boolean;
    likesCount?: number;
    favorited?: boolean;
    comments?: Array<{
      id: string;
      author: string;
      content: string;
      createdAt: string;
      isMine?: boolean;
      replies?: Array<{ id: string; author: string; content: string; createdAt: string; isMine?: boolean }>;
    }>;
    moderationMode?: string;
  }) => {
    if (likeCount && typeof data.likesCount === 'number') {
      likeCount.textContent = String(data.likesCount);
    }

    if (favoriteState && typeof data.favorited === 'boolean') {
      favoriteState.textContent = data.favorited ? '已收藏' : '未收藏';
    }

    if (typeof data.liked === 'boolean') {
      likeButton?.classList.toggle('is-active', data.liked);
      likeButton?.setAttribute('aria-pressed', String(data.liked));
      likeButton?.setAttribute('aria-label', data.liked ? '点赞，已点赞' : '点赞');
    }

    if (typeof data.favorited === 'boolean') {
      favoriteButton?.classList.toggle('is-active', data.favorited);
      favoriteButton?.setAttribute('aria-pressed', String(data.favorited));
      favoriteButton?.setAttribute('aria-label', data.favorited ? '收藏，已收藏' : '收藏');
      window.dispatchEvent(new CustomEvent('yufu:favorites-updated', {
        detail: {
          slug: postSlug,
          title: postTitle,
          favorited: data.favorited,
        },
      }));
    }

    if (Array.isArray(data.comments)) {
      renderComments(data.comments);
    }

    if (commentEmpty && data.moderationMode === 'manual' && !data.comments?.length) {
      commentEmpty.textContent = '公开评论为空，新的留言会先进入待审核状态。';
    }
  };

  const escapeHtml = (value) =>
    String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  const renderComments = (items: Array<{ id: string; author: string; content: string; createdAt: string; isMine?: boolean; replies?: Array<{ id: string; author: string; content: string; createdAt: string; isMine?: boolean }> }>) => {
    if (!commentList || !commentEmpty) return;

    commentList.innerHTML = items
      .slice()
      .reverse()
      .map((item) => `
        <article class="comment-item">
          <div class="comment-item-head">
            <div class="comment-author-row">
              <strong>${escapeHtml(item.author)}</strong>
              <time>${new Date(item.createdAt).toLocaleString('zh-CN')}</time>
            </div>
            <div class="comment-actions">
              <button type="button" class="comment-reply" data-comment-id="${item.id}" data-comment-author="${escapeHtml(item.author)}">回复</button>
              ${
                item.isMine
                  ? `<button type="button" class="comment-delete" data-comment-id="${item.id}">删除</button>`
                  : ''
              }
            </div>
          </div>
          <p>${escapeHtml(item.content)}</p>
          ${
            item.replies?.length
              ? `<div class="reply-list">
                  ${item.replies
                    .slice()
                    .reverse()
                    .map(
                      (reply) => `
                        <article class="reply-item">
                          <div class="comment-item-head">
                            <div class="comment-author-row">
                              <strong>${escapeHtml(reply.author)}</strong>
                              <time>${new Date(reply.createdAt).toLocaleString('zh-CN')}</time>
                            </div>
                            <div class="comment-actions">
                              ${
                                reply.isMine
                                  ? `<button type="button" class="comment-delete" data-comment-id="${reply.id}">删除</button>`
                                  : ''
                              }
                            </div>
                          </div>
                          <p>${escapeHtml(reply.content)}</p>
                        </article>
                      `
                    )
                    .join('')}
                </div>`
              : ''
          }
        </article>
      `)
      .join('');

    commentEmpty.style.display = items.length ? 'none' : 'block';
  };

  const clearReplying = () => {
    if (replyParentId) {
      replyParentId.value = '';
    }
    if (replyingBanner) {
      replyingBanner.style.display = 'none';
    }
    if (replyingText) {
      replyingText.textContent = '';
    }
    if (commentSubmit) {
      commentSubmit.textContent = '发布评论';
    }
  };

  const syncEngagement = () => {
    if (!postSlug) return Promise.resolve();

    return fetch(`/.netlify/functions/engagement?slug=${encodeURIComponent(postSlug)}`, {
      headers: {
        'x-client-id': getClientId(),
      },
    })
      .then((response) => response.json())
      .then((data) => {
        applyEngagementState(data);
        setStatus('');
      })
      .catch(() => {
        // dev:no-mock 降级：本地态至少把点赞/收藏按钮点亮
        if (localStorage.getItem(`yufu:local-like:${postSlug}`) === '1' && likeButton && likeCount) {
          likeCount.textContent = '1';
          likeButton.classList.add('is-active');
          likeButton.setAttribute('aria-pressed', 'true');
        }
        const localFav = (JSON.parse(localStorage.getItem('yufu:local-favorites') || '[]') as Array<{ slug: string }>).some(
          (item) => item.slug === postSlug
        );
        if (localFav && favoriteButton && favoriteState) {
          favoriteState.textContent = '已收藏';
          favoriteButton.classList.add('is-active');
          favoriteButton.setAttribute('aria-pressed', 'true');
        }
        if (commentEmpty) {
          commentEmpty.textContent = '互动服务未启动（dev:no-mock？）：点赞/收藏走本地降级，评论需在线。';
          commentEmpty.style.display = 'block';
        }
        setStatus('互动服务未启动：点赞/收藏已切本地降级。', true);
      });
  };

  likeButton?.addEventListener('click', () => {
    if (!postSlug) return;
    window.dispatchEvent(new CustomEvent('yufu:pet-excite'));
    fetch('/.netlify/functions/engagement', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-client-id': getClientId(),
      },
      body: JSON.stringify({ slug: postSlug, action: 'like' }),
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || '点赞失败');
        }
        applyEngagementState(data);
      })
      .catch(() => {
        // dev:no-mock / 离线降级：点赞记本地，联网后自动回服务端
        const key = `yufu:local-like:${postSlug}`;
        const liked = localStorage.getItem(key) === '1';
        localStorage.setItem(key, liked ? '0' : '1');
        if (likeButton && likeCount) {
          const base = Number(likeCount.textContent || '0') || 0;
          likeCount.textContent = String(liked ? Math.max(0, base - 1) : base + 1);
          likeButton.classList.toggle('is-active', !liked);
          likeButton.setAttribute('aria-pressed', String(!liked));
        }
        setStatus('离线模式：点赞已记在本地（联网后走服务端）。');
      });
  });

  favoriteButton?.addEventListener('click', () => {
    if (!postSlug) return;
    window.dispatchEvent(new CustomEvent('yufu:pet-excite'));
    fetch('/.netlify/functions/engagement', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-client-id': getClientId(),
      },
      body: JSON.stringify({ slug: postSlug, title: postTitle, action: 'favorite' }),
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || '收藏失败');
        }
        applyEngagementState(data);
      })
      .catch(() => {
        // dev:no-mock / 离线降级：收藏记本地
        const listKey = 'yufu:local-favorites';
        const list = JSON.parse(localStorage.getItem(listKey) || '[]') as Array<{ slug: string; title: string }>;
        const exists = list.some((item) => item.slug === postSlug);
        const next = exists
          ? list.filter((item) => item.slug !== postSlug)
          : [...list, { slug: postSlug, title: postTitle }];
        localStorage.setItem(listKey, JSON.stringify(next));
        if (favoriteButton && favoriteState) {
          favoriteState.textContent = exists ? '未收藏' : '已收藏';
          favoriteButton.classList.toggle('is-active', !exists);
          favoriteButton.setAttribute('aria-pressed', String(!exists));
        }
        setStatus('离线模式：收藏已记在本地（联网后走服务端）。');
      });
  });

  replyCancel?.addEventListener('click', () => {
    clearReplying();
    setStatus('');
  });

  commentForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!postSlug || !commentAuthor || !commentContent || !replyParentId) return;

    const author = commentAuthor.value.trim() || '匿名';
    const content = commentContent.value.trim();
    if (!content) {
      setStatus('评论不能为空。', true);
      return;
    }

    if (content.length < 2) {
      setStatus('评论至少写两个字。', true);
      return;
    }

    setStatus('正在发布...');
    if (commentSubmit) {
      commentSubmit.disabled = true;
      commentSubmit.textContent = '发布中...';
    }

    fetch('/.netlify/functions/engagement', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-client-id': getClientId(),
      },
      body: JSON.stringify({ slug: postSlug, action: 'comment', author, content, parentId: replyParentId.value, website: (document.getElementById('commentWebsite') as HTMLInputElement | null)?.value ?? '' }),
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || '发布失败');
        }
        commentContent.value = '';
        if (commentAuthor) {
          localStorage.setItem(authorKey, commentAuthor.value.trim());
        }
        clearReplying();
        setStatus(data.pending ? '评论已提交，等待审核。' : '评论已发布。');
        applyEngagementState(data);
      })
      .catch((error) => {
        setStatus(error.message || '发布失败。', true);
      })
      .finally(() => {
        if (commentSubmit) {
          commentSubmit.disabled = false;
          commentSubmit.textContent = '发布评论';
        }
      });
  });

  commentList?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const replyButton = target.closest('.comment-reply') as HTMLButtonElement | null;
    const button = target.closest('.comment-delete') as HTMLButtonElement | null;

    if (replyButton && replyParentId && replyingBanner && replyingText && commentContent && commentSubmit) {
      replyParentId.value = replyButton.dataset.commentId || '';
      replyingText.textContent = `正在回复 ${replyButton.dataset.commentAuthor || '这条评论'}`;
      replyingBanner.style.display = 'flex';
      commentSubmit.textContent = '发布回复';
      commentContent.focus();
      setStatus('');
      return;
    }

    if (!button || !postSlug) return;

    if (!window.confirm('确定删除这条评论吗？删除后不可恢复。')) {
      return;
    }

    setStatus('正在删除...');
    fetch('/.netlify/functions/engagement', {
      method: 'POST',
      headers: {
        'content-type': 'application/json',
        'x-client-id': getClientId(),
      },
      body: JSON.stringify({ slug: postSlug, action: 'delete-comment', commentId: button.dataset.commentId }),
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || '删除失败');
        }
        setStatus('评论已删除。');
        applyEngagementState(data);
      })
      .catch((error) => {
        setStatus(error.message || '删除失败。', true);
      });
  });

  syncEngagement();
</script>

<style>
  .blog-post {
    max-width: 1120px;
    margin: 0 auto;
    padding: 1rem 0 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    transition:
      color 0.25s ease,
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .back-link:hover {
    color: var(--text-primary);
    transform: translateY(-2px);
    border-color: rgba(255, 179, 71, 0.35);
  }

  .post-hero,
  .content-shell {
    position: relative;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: linear-gradient(180deg, rgba(9, 17, 31, 0.8), rgba(12, 24, 43, 0.72));
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
  }

  .post-hero {
    margin-top: 1rem;
    padding: clamp(1.8rem, 4vw, 3rem);
    overflow: clip;
  }

  .post-hero::after {
    content: "";
    position: absolute;
    inset: auto -5rem -5rem auto;
    width: 18rem;
    height: 18rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 122, 24, 0.22), transparent 70%);
    pointer-events: none;
  }

  .hero-topline {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .hero-topline span,
  .meta-tags span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .hero-topline span {
    background: rgba(255, 255, 255, 0.06);
    color: var(--accent-soft);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.2rem;
    align-items: end;
  }

  .post-hero h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 6vw, 5.1rem);
    line-height: 0.97;
    letter-spacing: -0.05em;
  }

  .post-summary {
    max-width: 42rem;
    margin-top: 1.2rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1.6rem;
    color: var(--text-muted);
  }

  .engagement-bar {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }

  .engage-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .engage-button:hover {
    transform: translateY(-2px);
