---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title="404 · 这条鱼游走了 · 鱼腹" description="页面不存在，或者已经挪了窝。">
  <main class="notfound-shell">
    <p class="notfound-kicker">404 · Signal Lost</p>
    <h1 class="notfound-title">这条鱼游走了</h1>
    <p class="notfound-desc">页面不存在，或者已经挪了窝。下面几条路都能把你带回有信号的地方。</p>
    <div class="notfound-actions">
      <a class="notfound-home" href="/">返回首页</a>
      <a class="notfound-rss" href="/rss.xml">RSS 订阅</a>
    </div>
    <div class="notfound-latest">
      <p class="notfound-latest-label">最近的三篇</p>
      <ul>
        {latest.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time>{new Date(post.data.pubDate).toLocaleDateString('zh-CN')}</time>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .notfound-shell {
    max-width: 44rem;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .notfound-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 1.2rem;
  }

  .notfound-title {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }

  .notfound-desc {
    opacity: 0.68;
    margin-bottom: 2.2rem;
  }

  .notfound-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.2rem;
  }

  .notfound-actions a {
    padding: 0.55rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    text-decoration: none;
    color: inherit;
  }

  .notfound-home {
    background: rgba(255, 255, 255, 0.08);
  }

  .notfound-latest {
    text-align: left;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    padding: 1.4rem 1.6rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .notfound-latest-label {
    font-size: 0.76rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 0.9rem;
  }

  .notfound-latest ul {
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .notfound-latest li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .notfound-latest a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.28);
  }

  .notfound-latest time {
    opacity: 0.5;
    font-size: 0.78rem;
    white-space: nowrap;
  }
</style>
